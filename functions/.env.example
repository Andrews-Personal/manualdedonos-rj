# ============================================================================
# functions/.env.example — segredos do backend (Cloud Functions)
#
# Este arquivo NÃO vai para o bundle do navegador. É aqui, e só aqui, que
# vivem chaves de verdade. Em produção, prefira o Secret Manager:
#
#   firebase functions:secrets:set GEMINI_API_KEY
#
# Em desenvolvimento com emuladores, um `functions/.env` local já resolve.
# Uso: cp functions/.env.example functions/.env
# ============================================================================

# Chave da API do Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo usado no cruzamento de negócios. Opcional (padrão: gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash
