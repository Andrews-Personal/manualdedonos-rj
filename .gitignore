# ============================================================================
# Manual de Donos — Empresários do Rio
#
# Regra geral: configuração do projeto é versionada (firebase.json, .firebaserc,
# regras e índices — o deploy do GitHub Actions depende deles estarem no repo).
# Segredo nenhum entra aqui.
# ============================================================================

# Dependências e build
node_modules/
functions/node_modules/
dist/
dist-ssr/
functions/lib/
*.tsbuildinfo
.vite/

# Cache de ferramentas
.eslintcache
.pnpm-store/
*.local

# ----------------------------------------------------------------------------
# Segredos — NUNCA versionar
# ----------------------------------------------------------------------------
# Chaves do frontend (VITE_*) e segredos das Cloud Functions (GEMINI_API_KEY).
.env
.env.*
!.env.example
functions/.env
functions/.env.*
!functions/.env.example

# Service account do Firebase usado pelo GitHub Actions / scripts locais.
# Se este arquivo vazar, quem tiver ele publica no seu projeto de produção.
service-account.json
*-firebase-adminsdk-*.json
gha-creds-*.json

# ----------------------------------------------------------------------------
# Firebase — artefatos locais
# ----------------------------------------------------------------------------
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
database-debug.log
ui-debug.log
pubsub-debug.log
storage-debug.log
firebase-export-*/
seed-data/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editores e sistema operacional
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
