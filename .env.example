# ============================================================================
# .env.example — Manual de Donos — Empresários do Rio
#
# São DOIS ambientes de variáveis, que nunca se misturam:
#
#   1. FRONTEND (este arquivo) → prefixo VITE_, copiado para `.env`.
#      ATENÇÃO: todo valor VITE_* é COMPILADO DENTRO DO BUNDLE público.
#      Qualquer pessoa consegue lê-lo no navegador. Só identificadores
#      públicos entram aqui. Nenhum segredo. Nunca.
#
#   2. CLOUD FUNCTIONS → `functions/.env` (veja functions/.env.example) e,
#      em produção, o Secret Manager. É lá que mora a GEMINI_API_KEY.
#
# Uso: cp .env.example .env  e preencha conforme um dos dois cenários abaixo.
# ============================================================================


# ----------------------------------------------------------------------------
# CENÁRIO A — Desenvolvimento só com emuladores (comece por aqui)
#
# Funciona SEM projeto criado no Firebase e SEM `firebase login`. O prefixo
# `demo-` faz os emuladores pularem qualquer chamada a produção, e nenhuma
# destas chaves é validada — são placeholders de propósito.
#
# O VITE_FIREBASE_PROJECT_ID precisa ser EXATAMENTE o mesmo projeto com que os
# emuladores sobem (`pnpm emulators:start` usa `demo-manualdedonos-rj`). Se
# divergir, o app conversa com um namespace diferente do que o
# `pnpm seed:dev-data` populou: tudo carrega vazio, sem erro nenhum.
# ----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-manualdedonos-rj.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-manualdedonos-rj
VITE_FIREBASE_STORAGE_BUCKET=demo-manualdedonos-rj.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_MEASUREMENT_ID=

VITE_ENVIRONMENT=development
VITE_APP_URL=http://localhost:5173
VITE_FUNCTIONS_REGION=southamerica-east1
VITE_USE_EMULATORS=true


# ----------------------------------------------------------------------------
# CENÁRIO B — Projeto real do Firebase
#
# Substitua os valores acima pelos do seu projeto:
# Console do Firebase → Configurações do projeto → Seus apps → App da Web →
# Configuração do SDK. E troque VITE_USE_EMULATORS para false.
#
# Estes valores são públicos por design; quem protege os dados são as
# firestore.rules / storage.rules, não o sigilo destas chaves.
#
#   VITE_FIREBASE_API_KEY=AIza...
#   VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
#   VITE_FIREBASE_PROJECT_ID=seu-projeto
#   VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
#   VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
#   VITE_FIREBASE_APP_ID=1:123456789012:web:abc123
#   VITE_ENVIRONMENT=production
#   VITE_APP_URL=https://seu-projeto.web.app
#   VITE_USE_EMULATORS=false
#
# Para rodar os emuladores apontando para o ID do projeto real em vez do demo:
#   FIREBASE_PROJECT=seu-projeto pnpm emulators:start
# ----------------------------------------------------------------------------
